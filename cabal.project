packages:
  .

-- miso 1.15.0 (includes the destroy-hook DOMRef fix, dmjio/miso#1636).
-- For local development against a checkout, override with a
-- cabal.project.local instead.
source-repository-package
  type: git
  location: https://github.com/dmjio/miso
  tag: 1.15.0

allow-newer:
  all:base

package miso
  flags: +template-haskell
